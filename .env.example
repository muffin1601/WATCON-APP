 # ─────────────────────────────────────────────────────────────
# Watcon Enterprise — environment configuration
# Copy to `.env` (local) and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required).
# Local dev with `npm run db:start` (embedded PostgreSQL on port 5433):
DATABASE_URL="postgresql://watcon:watcon_local_dev@localhost:5433/watcon_dev"

# Managed / VPS PostgreSQL: append TLS settings, e.g. "?sslmode=require" (or
# "?sslmode=verify-full&sslrootcert=/path/ca.pem" when the provider ships a CA).
# Serverless platforms (Vercel): use the provider's POOLED connection string here.

# Migrations only (optional): a NON-transaction-pooled URL used by `prisma migrate`.
# Supabase: the "Session pooler" string (port 5432). Leave empty locally.
# Never set this in the Vercel runtime environment.
DIRECT_URL=""

# Optional: PEM of the provider's CA, for providers not in Node's trust store (Supabase).
# Keeps TLS fully verified. Paste the whole certificate (newlines or literal \n).
DB_SSL_CA=""

# Max connections per app instance (default 10). Use 3–5 on serverless platforms.
DB_POOL_MAX="10"

# Public base URL of the app — used to build password-reset links.
# REQUIRED in production: the app refuses to start auth flows without it.
APP_URL="http://localhost:3000"

# Session lifetime: idle timeout (hours) and absolute maximum (days).
SESSION_IDLE_HOURS="12"
SESSION_MAX_DAYS="7"

# ── First Super Admin bootstrap (`npm run bootstrap:admin`) ──
# Used ONCE. The command refuses to run if a Super Admin already exists.
# Remove these values from the environment after bootstrapping.
BOOTSTRAP_ORG_NAME="Watcon"
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# ── Outgoing email (password reset) ──
# MAIL_TRANSPORT = "console" (logs the email to the server log; dev only) or "smtp".
MAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="Watcon <no-reply@example.com>"

# Business time zone used for 'today' / overdue calculations and timestamps.
APP_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

# Docker Compose only
POSTGRES_USER="watcon"
POSTGRES_PASSWORD=""
POSTGRES_DB="watcon"
