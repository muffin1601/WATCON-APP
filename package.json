                         "@tanstack/react-table":  "^8.21.3",
                         "class-variance-authority":  "^0.7.1",
                         "cmdk":  "^1.1.1",
                         "cn":  "^0.5.2",
                         "date-fns":  "^4.4.0",
                         "lucide-react":  "^1.74.0",
                         "next":  "16.4.6",
                         "next-themes":  "^0.4.6",
                         "nodemailer":  "^10.6.0",
                         "pg":  "^8.23.1",
                         "radix-ui":  "^1.8.1",
                         "react":  "19.3.0",
                         "react-day-picker":  "^10.0.2",
                         "react-dom":  "19.3.0",
                         "react-hook-form":  "^7.92.0",
                         "server-only":  "^0.0.1",
                         "sonner":  "^2.0.8",
                         "tw-animate-css":  "^1.4.0",
                         "zod":  "^4.6.7"
                     },
    "devDependencies":  {
